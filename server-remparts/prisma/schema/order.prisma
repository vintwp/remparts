model Order {
  id          Int @id @default(autoincrement()) @map("order_id")
  id1c        String? @map("order_id_1c")
  orderHash   String? @map("order_hash")
  user        User @relation(fields: [userEmail], references: [email])
  userEmail   String @map("user_email") 
  item        OrderToItem[]
  processed   Boolean @default(false)
  comment     String? @map("order_comment")
  totalAmount Float @default(0)
  invoiceId   String @default("")
  invoiceHash String @default("")
  createdAt   DateTime  @default(now()) @map("created_at")
  
  @@map("order")
}

model OrderToItem {
  id          Int  @id @default(autoincrement())
  order       Order @relation(fields: [orderId], references: [id])
  orderId     Int @map("order_id")
  item        Item @relation(fields: [itemId], references: [id])
  itemId      Int
  itemPrice   Float @map("item_price")
  itemQty     Int @default(1) @map("item_qty")

  @@map("_order_to_item")
}