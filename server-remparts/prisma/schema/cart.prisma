model Cart {
  id         Int @id @default(autoincrement()) @map("cart_id")
  user       User   @relation(fields: [userEmail], references: [email])
  userEmail  String @unique @map("user_email")
  item       CartToItem[]

  @@map("cart")
}

model CartToItem {
  cart        Cart @relation(fields: [cartEmail], references: [userEmail])
  cartEmail   String @map("cart_email")
  item        Item @relation(fields: [itemId], references: [id])
  itemId      Int
  itemQty     Int @default(1) @map("item_qty")

  @@map("_cart_to_item")
  @@id([cartEmail, itemId])
}