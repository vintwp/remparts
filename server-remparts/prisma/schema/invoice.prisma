model Invoice {
  id       String @id @unique
  user     User @relation(fields: [userId], references: [id1c])
  userId   String @unique @map("user_id")
  item     InvoiceToItem[]
  createdAt   DateTime

  @@map("invoice")
}


model InvoiceToItem {
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId   String @map("invoice_id")
  item        Item @relation(fields: [itemId], references: [id1c])
  itemId      String
  price       Float @map("item_price")
  itemQty     Int @default(1) @map("item_qty")

  @@id([invoiceId])
  @@map("_invoice_to_item")
}