model Invoice {
  id          String @id @unique @map("invoice_id")
  id1c        String @map("invoice_id_1c")
  user        User @relation(fields: [userId], references: [id])
  userId      Int @map("user_id")
  item        InvoiceToItem[]
  totalAmount Float @default(0) @map("invoice_total_amount")
  createdAt   DateTime

  @@map("invoice")
}


model InvoiceToItem {
  invoice         Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId       String @map("invoice_id")
  item            Item @relation(fields: [itemId], references: [id1c])
  itemId          String @map("item_id")
  price           Float @map("item_price")
  itemQty         Int @default(1) @map("item_qty")
  amountPerItem   Float @default(0) @map("item_amount_per")

  @@id([invoiceId, itemId])
  @@map("_invoice_to_item")
}