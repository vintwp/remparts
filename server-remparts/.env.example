# This is an example .env file.
# Rename it to `.env` and update the variables to match your configuration.

NODE_ENV=development

# Base Host and Port
HOST=localhost
PORT=5000

COOKIE_DOMAIN=${HOST}

# PostgreSQL Database
DATABASE_HOST=${HOST}
DATABASE_USER=root
DATABASE_PASSWORD=db_password
DATABASE_PORT=5433
DATABASE_NAME=db_name
DATABASE_URL="postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?schema=public"

# PgAdmin
PGADMIN_EMAIL=root@gmail.com
PGADMIN_PASSWORD=pg_admin_password

# Redis
REDIS_HOST=${HOST}
REDIS_PORT=6379

# MeiliSearch
MEILI_HOST=${HOST}
MEILI_PORT=7700
MEILI_MASTER_KEY=meili_master_key

# JWT Auth
JWT_SECRET=jwt_secret_key
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=2d

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=google_oauth_client_secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5000/api/auth/google-redirect

# Google reCAPTCHA
GOOGLE_RECAPTCHA_SECRET_KEY=google_recaptcha_secret_key

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=google_app_password
EMAIL_CONFIRMATION_TOKEN_TTL=30m

# Frontend/Backend URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000